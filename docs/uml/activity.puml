@startuml
start
:Enter login credentials;
:Authenticate user;
if (Login successful?) then (yes)
  :Open color page;
  repeat
    if (Choose action) then (search)
      :Search colors;
      :Display results;
    else (add)
      :Add color;
      :Show confirmation;
    endif
  repeat while (Continue?) is (yes)
  :Log out;
else (no)
  :Show login error;
endif
stop
@enduml
